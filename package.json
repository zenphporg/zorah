{
  "name": "zorah-js",
  "version": "2.1.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "source": "./src/ts/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "fix": "bunx lint-staged",
    "cb": "composer update && bun update && sync-deps",
    "build": "bun build:esm && bun build:umd",
    "build:esm": "microbundle -i ./src/ts/index.ts -o ./dist/index.js --format esm,cjs --no-sourcemap --external none",
    "build:npm": "microbundle -i ./src/ts/index.ts -o ./dist/index.js --format modern,esm --no-sourcemap",
    "build:umd": "microbundle -i ./src/ts/browser.ts -o ./dist/trans.js --format umd --name trans --no-sourcemap --external none",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/ts/",
    "format:check": "prettier --check src/ts/",
    "prebuild": "rm -rf ./dist/*"
  },
  "mangle": {
    "regex": "^_[^_]"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.9.18",
    "caniuse-lite": "^1.0.30001766",
    "qs": "~6.14.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "microbundle": "^0.15.1",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": "prettier --write .",
    "*.php": "./vendor/bin/fixr --dirty"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        120
      ],
      "type-enum": [
        2,
        "always",
        [
          "breaking",
          "feat",
          "fix",
          "refactor",
          "docs",
          "task",
          "issue",
          "wip",
          "chore",
          "style",
          "test"
        ]
      ]
    }
  }
}
