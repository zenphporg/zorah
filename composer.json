{
  "name": "zenphp/zorah",
  "description": "Add your Laravel language translations to your asset pipeline for use in Javascript packages like Vue or React.",
  "license": "MIT",
  "authors": [
    {
      "name": "SMV",
      "email": "secondman@zenphp.org"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/filesystem": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.12",
    "orchestra/testbench": "^10.9.0",
    "pestphp/pest": "^4.3.1",
    "pestphp/pest-plugin-laravel": "^4.0.0",
    "pestphp/pest-plugin-type-coverage": "^4.0.3",
    "rector/rector": "^2.3.4",
    "zenphp/fixr": "^1.0.4"
  },
  "autoload": {
    "psr-4": {
      "Zen\\Zorah\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zorah\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zen\\Zorah\\ZorahServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "2.x-dev"
    }
  },
  "scripts": {
    "lint": [
      "./vendor/bin/rector",
      "./vendor/bin/fixr",
      "bun run format"
    ],
    "test:types": "./vendor/bin/pest --type-coverage --parallel --min=100",
    "test:lint": [
      "./vendor/bin/rector --dry-run",
      "./vendor/bin/fixr --test",
      "bun run typecheck",
      "bun run format:check"
    ],
    "test:feat": "./vendor/bin/pest --parallel",
    "test:coverage": "./vendor/bin/pest --parallel --coverage-clover=clover.xml --min=100.0; php bin/clean-coverage",
    "test:static": "./vendor/bin/phpstan analyze",
    "test": [
      "@test:types",
      "@test:static",
      "@test:lint",
      "@test:types",
      "@test:feat"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
