{
  "name": "zenphp/zorah",
  "description": "Add your Laravel language translations to your asset pipeline for use in Javascript packages like Vue or React.",
  "license": "MIT",
  "authors": [
    {
      "name": "SMV",
      "email": "secondman@zenphp.org"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/filesystem": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "zenphp/fixr": "^1.0.4",
    "pestphp/pest": "^3.8.4",
    "pestphp/pest-plugin-type-coverage": "^3.6.1",
    "pestphp/pest-plugin-laravel": "^3.2.0",
    "mockery/mockery": "^1.6.12",
    "rector/rector": "^2.2.11",
    "orchestra/testbench": "^10.8.0"
  },
  "autoload": {
    "psr-4": {
      "Zen\\Zorah\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zorah\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zen\\Zorah\\ZorahServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "scripts": {
    "test": "./vendor/bin/pest",
    "test:coverage": "./vendor/bin/pest --coverage --min=100",
    "fix": "./vendor/bin/fixr",
    "analyze": "./vendor/bin/phpstan analyze"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
